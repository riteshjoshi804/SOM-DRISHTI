# Copy to .env to override defaults. Relative paths are resolved from the project root.
# No API keys are required anywhere in this project.

# Official mentor dataset (read-only input)
SOM_DRISHTI_DATA_DIR=data/official_sih_2026

# Where jobs, benchmarks and caches are written
SOM_DRISHTI_RESULTS_DIR=results

# Scene used by scripts/run_registration.py when --scene is omitted
SOM_DRISHTI_FIRST_SCENE=OHRXXD18CHO2359602NNNN24342131250969_V1_0_03

# Origins allowed to call the API directly (the Vite dev server proxies, so this is rarely needed)
SOM_DRISHTI_CORS_ORIGINS=http://localhost:5173

# Where the pretrained weights of the learned matchers are kept (never in Git)
SOM_DRISHTI_MODELS_DIR=models
